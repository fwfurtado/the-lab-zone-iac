metadata_dir = "{{ garage_meta_dir }}"
data_dir = "{{ garage_data_dir }}"

replication_factor = 1

rpc_secret = "{{ garage_rpc_secret }}"
rpc_bind_addr = "[::]:3901"

[s3_api]
api_bind_addr = "[::]:3900"
s3_region = "garage"
root_domain = ".s3.infra.the-lab.zone"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.the-lab.zone"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ garage_admin_token }}"
