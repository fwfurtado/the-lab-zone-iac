	# ── ACME via Cloudflare DNS challenge ──
	cert_issuer acme {
		dns cloudflare "{{ op://development/Cloudflare/the-lab.zone }}"
		resolvers 1.1.1.1 1.0.0.1
	}

	# ── Layer4 for SSH passthrough ──
	layer4 {
		:22 {
			route {
				proxy "10.40.1.21:22"
			}
		}
	}

	# ── Logging ──
	log {
		level info
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
		}
		format json
	}
}

